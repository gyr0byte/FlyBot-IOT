# FlyBot environment variables — EXAMPLE ONLY.
# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# The ESP32 does not read this file: its credentials go in firmware/include/secrets.h.
# The esp32 entries are listed here so the Mosquitto password file can be built from one place.

# ---------- Robot ----------
FLYBOT_ROBOT_ID=01

# ---------- MQTT broker ----------
# Development: Mosquitto on the laptop. Production: Azure VM hostname.
# Comments must stay on their own lines: systemd EnvironmentFile does not strip
# trailing comments.
MQTT_HOST=localhost
# Plain MQTT (development only)
MQTT_PORT=1883
# WebSockets (dashboard, development only)
MQTT_WS_PORT=9001
# MQTT over TLS (production)
MQTT_TLS_PORT=8883
# Secure WebSockets (production dashboard)
MQTT_WSS_PORT=8884
# true in production
MQTT_USE_TLS=false

# ---------- MQTT users (one per client; see docs/message-contract.md §4) ----------
MQTT_ESP32_USER=esp32
MQTT_ESP32_PASS=change-me-esp32

MQTT_SIM_USER=sim
MQTT_SIM_PASS=change-me-sim

MQTT_BRAIN_USER=brain
MQTT_BRAIN_PASS=change-me-brain

MQTT_DASHBOARD_USER=dashboard
MQTT_DASHBOARD_PASS=change-me-dashboard

MQTT_BOT_USER=bot
MQTT_BOT_PASS=change-me-bot

# ---------- Telegram bot ----------
TELEGRAM_BOT_TOKEN=000000000:replace-with-token-from-botfather
TELEGRAM_ALLOWED_CHAT_ID=000000000

# ---------- Storage ----------
# Keep on D: during development (see CLAUDE.md). On the VM, e.g. /var/lib/flybot/flybot.db
FLYBOT_DB_PATH=D:/Python/FlyBot/data/flybot.db
