# Copy to dashboard/.env.local (git-ignored) and fill in. Read by the dashboard's server only.
DASHBOARD_PASSWORD=choose-a-password
# Random string used to sign the login cookie (python -c "import secrets; print(secrets.token_hex(32))")
DASHBOARD_SESSION_SECRET=replace-with-random-hex
# The logger's read API (python -m flybot_brain.logger api)
LOGGER_API_URL=http://127.0.0.1:8000
# Optional: public broker address for the browser (default MQTT_HOST and MQTT_WS_PORT from the repo .env)
# MQTT_WS_URL=ws://127.0.0.1:9001
