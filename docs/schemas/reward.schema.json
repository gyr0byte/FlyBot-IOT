{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flybot:schema:reward",
  "title": "flybot/01/reward",
  "description": "Reward or punishment for the brain, QoS 1, not retained, on press. Receivers drop duplicates by (src, seq). Contract section 3.8.",
  "type": "object",
  "properties": {
    "v": { "const": 3, "description": "Schema version." },
    "seq": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Per-sender, per-topic sequence number." },
    "up": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Sender uptime, ms." },
    "bid": { "type": "integer", "minimum": 1, "maximum": 4294967295, "description": "Boot ID of the robot: required when src is btn, absent otherwise." },
    "r": {
      "enum": [1, -1],
      "description": "1 = reward, -1 = punishment."
    },
    "src": {
      "type": "string",
      "pattern": "^(btn|bot|dash-[0-9a-f]{6})$",
      "description": "Sender name: btn (robot or simulator button), bot, or a dashboard tab's dash-xxxxxx."
    }
  },
  "required": ["v", "seq", "up", "r", "src"],
  "additionalProperties": false,
  "if": {
    "properties": {
      "src": { "const": "btn" }
    },
    "required": ["src"]
  },
  "then": {
    "required": ["bid"]
  },
  "else": {
    "not": {
      "required": ["bid"]
    }
  },
  "examples": [
    { "v": 3, "seq": 3, "up": 120455, "r": 1, "src": "bot" },
    { "v": 3, "seq": 0, "up": 8120, "r": -1, "src": "dash-3fa2c1" },
    { "v": 3, "seq": 2, "up": 95200, "bid": 2847193551, "r": 1, "src": "btn" }
  ]
}
