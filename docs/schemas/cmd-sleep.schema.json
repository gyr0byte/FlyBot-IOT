{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flybot:schema:cmd-sleep",
  "title": "flybot/01/cmd/sleep",
  "description": "Brain sleep/wake request to the robot, QoS 1, not retained, published only by the brain. On change and every 5 s while asleep. Ignored by the robot in estop or manual mode. Contract section 3.7.",
  "type": "object",
  "properties": {
    "v": { "const": 1, "description": "Schema version." },
    "seq": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Per-sender, per-topic sequence number." },
    "up": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Sender uptime, ms." },
    "s": { "type": "boolean", "description": "true = sleep, false = wake." },
    "why": { "enum": ["dark", "light", "user"], "description": "Cause: light sensor dark/light, or a brain/control sleep request." }
  },
  "required": ["v", "seq", "up", "s", "why"],
  "additionalProperties": false,
  "examples": [
    { "v": 1, "seq": 2, "up": 610000, "s": true, "why": "dark" }
  ]
}
